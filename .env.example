# Database connection (PostgreSQL)
# Format: postgresql+psycopg2://<user>:<password>@<host>:<port>/<dbname>
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/secure_file_transfer

# JWT Secret Key for signing session tokens (must be a strong random secret)
SECRET_KEY=b9f27c44243a819b16e83d8e57f00bb25b138865ceb11dc05d3b64c4fe8e7921

# Master Encryption Key (Fernet 32-byte base64-encoded key)
# Used to wrap/encrypt per-file data encryption keys (DEKs)
# Generate a new key with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
MASTER_KEY=o2m3T9G48V_z5FkR_oX7eH-5xGk_s0Q4G9zZ5qO6W7s=

# JWT token expiration time in minutes
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Maximum allowed file upload size in megabytes
MAX_UPLOAD_MB=10
